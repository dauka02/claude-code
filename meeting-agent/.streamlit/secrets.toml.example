# Локальный пример секретов. Скопируйте в .streamlit/secrets.toml и заполните.
# В git коммитится ТОЛЬКО этот .example-файл; реальный secrets.toml — в .gitignore.
# На Streamlit Cloud те же ключи вставляются в Settings → Secrets (формат тот же).

ANTHROPIC_API_KEY = "sk-ant-..."

# whisper_api | yandex | whisper_local
TRANSCRIBE_ENGINE = "whisper_api"

# Для whisper_api (OpenAI Whisper):
OPENAI_API_KEY = "sk-..."

# Для yandex (KZ / микс RU-KZ):
YANDEX_API_KEY = "..."
YANDEX_LANG = "ru-RU"          # например "kk-KK" для казахского

# Фаза 2 — рассылка:
TELEGRAM_BOT_TOKEN = "123456:ABC-..."
GMAIL_USER = "you@gmail.com"
GMAIL_APP_PASSWORD = "app-password"
