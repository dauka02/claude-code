# Скопируйте этот файл в .env и подставьте свой ключ.
# Получить ключ: https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-...

# Необязательно: переопределить модель (по умолчанию claude-opus-4-8)
# SIGNAGE_MODEL=claude-opus-4-8

# Необязательно: путь к своей базе правил дизайн-кода
# SIGNAGE_RULES_PATH=signage_precheck/rules_base.yaml
