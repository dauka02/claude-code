# --- Telegram ---
BOT_TOKEN=
# Супергруппа с включёнными Темами (Topics); бот — админ с правом «Управление темами».
OPERATOR_GROUP_ID=
# Опц. префикс ответов оператора, напр. «Специалист Центра урбанистики:»
OPERATOR_RELAY_PREFIX=

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Google (сервисный аккаунт с доступом к Sheets и Drive) ---
# Локально: путь к файлу. На Railway: вставьте СОДЕРЖИМОЕ service_account.json
# целиком (строка, начинающаяся с "{") — файл в репозиторий класть нельзя.
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json
SHEET_ID=
GDRIVE_FOLDER_ID=

# --- Логика ---
CONFIDENCE_THRESHOLD=0.7
ALWAYS_ESCALATE_INTENTS=12
KB_REFRESH_SECONDS=300
KZ_AUTOTRANSLATE=true

# --- Рабочие часы (часы бота/панели, НЕ часы приёма эскизов из KB) ---
TIMEZONE=Asia/Almaty
WORK_DAYS=1-5
WORK_START=09:00
WORK_END=18:00
WORK_HOURS=Пн–Пт 09:00–18:00

# --- Прочее ---
LOG_LEVEL=INFO
# Локально оставьте как есть. На Railway примонтируйте Volume и укажите путь
# внутри него, иначе состояние (темы, режимы) сбрасывается при каждом деплое:
#   DB_PATH=/data/state.db
DB_PATH=./data/state.db
# Авто-заливка KB_seed.csv при первом старте, если вкладка KB пустая.
SEED_KB_IF_EMPTY=true
